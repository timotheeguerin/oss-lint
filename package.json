{
  "name": "oss-lint",
  "version": "0.1.0",
  "description": "Lint good practices for open-source projects (lock files, .npmrc, and more)",
  "keywords": [
    "oss",
    "lint",
    "linter",
    "lockfile",
    "registry",
    "best-practices"
  ],
  "homepage": "https://github.com/timotheeguerin/oss-lint#readme",
  "bugs": "https://github.com/timotheeguerin/oss-lint/issues",
  "license": "MIT",
  "author": "Timothee Guerin",
  "repository": "timotheeguerin/oss-lint.git",
  "type": "module",
  "bin": {
    "oss-lint": "cmd/cli.mjs"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "cmd",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "watch": "tsc -p ./tsconfig.build.json --watch",
    "clean": "rimraf dist/ .temp/",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest -w"
  },
  "dependencies": {
    "globby": "^16.2.2",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
